## Copy this file to "keystore.properties" (same folder) and fill in your
## real values. keystore.properties is gitignored — it must never be committed.
##
## The keystore file itself (dubaival-release.keystore) is also gitignored
## and must never be committed. Keep both in a password manager / secure
## backup — if you lose them, you cannot publish an update to an app already
## installed from a previous signed build; you'd have to ship under a new
## applicationId instead.

storeFile=dubaival-release.keystore
storePassword=REPLACE_ME
keyAlias=dubaival
keyPassword=REPLACE_ME
